# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Virtual envs
.venv/
venv/
env/

# Jupyter
.ipynb_checkpoints/

# OS / editor
.DS_Store
.idea/
.vscode/
*.swp

# Data — never commit raw or processed datasets
data/raw/*
data/processed/*
!data/raw/.gitkeep
!data/processed/.gitkeep
!data/README.md

# Results — keep directory structure, ignore heavy artifacts.
# Prediction npz files are small and required by scripts/generate_final_figures.py,
# so they stay tracked.
results/**/*.npz
!results/**/predictions_*.npz
results/**/*.pkl
results/**/*.pt
results/**/*.h5
results/**/*.parquet

# LaTeX build artifacts
report/*.aux
report/*.log
report/*.out
report/*.toc
report/*.bbl
report/*.blg
report/*.synctex.gz
report/*.fdb_latexmk
report/*.fls

# Local env
.env
.env.local

# Cluster operator runtime artifacts (job-id sentinel etc.)
cluster/.in_flight_jobs
